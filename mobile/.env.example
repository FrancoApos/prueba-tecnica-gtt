# URL base del backend. Expo embebe las vars EXPO_PUBLIC_* en el bundle.
#
# - Simulador iOS: http://localhost:3000 funciona.
# - Emulador Android: usá http://10.0.2.2:3000 (localhost del emulador no es el de tu PC).
# - Celular físico (Expo Go): usá la IP de LAN de tu PC, ej. http://192.168.1.100:3000
#   (tu PC y el celular tienen que estar en la misma red Wi-Fi).
# - App en el browser (expo start --web): http://localhost:3000 funciona.
#
# Para probar el chat en vivo entre el celular y la PC al mismo tiempo, poné la
# IP de LAN: sirve para los dos clientes (el browser también la alcanza).
EXPO_PUBLIC_API_URL=http://localhost:3000
