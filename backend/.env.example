PORT=3000

# Ver docker-compose.yml para levantar Mongo local; si corrés el backend
# fuera de Docker contra ese mismo compose, usá localhost en vez de "mongo".
MONGODB_URI=mongodb://localhost:27017/chat-app

# Reemplazalo de verdad: el backend reconoce este valor de ejemplo (está
# publicado en el repo) y lo trata como si no estuviera definido — genera uno
# random por proceso y lo avisa por log, así que las sesiones no sobreviven un
# reinicio hasta que pongas uno propio. Generá uno con: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Origen permitido para CORS (la app de React Native). "*" sirve para desarrollo.
CORS_ORIGIN=*

# Carpeta donde se guardan los adjuntos de los mensajes (relativa a backend/).
UPLOADS_DIR=uploads
